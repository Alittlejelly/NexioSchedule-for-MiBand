    border-radius: 10px;
    margin-right: 12px;
  }

  .app-text {
    flex-direction: column;
  }

  .app-name {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .app-ver {
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
  }

  .section-label {
    width: 100%;
    font-size: 14px;
