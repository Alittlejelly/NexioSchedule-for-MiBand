<template>
  <div class="page">
    <stack class="page-stack">
    <div class="body-layer">
    <stack class="day-stage" if="{{isHome}}">
      <div class="day-layer {{layer.layerClass}}" for="{{(layerIndex, layer) in dayLayers}}">
        <scroll class="body" scroll-y="true" bounces="true">
          <div class="screen" onswipe="onSwipe" ontouchstart="onTouchStart">
            <div class="header-row">
              <text class="weekday">{{layer.weekday}}</text>
              <text class="clock" if="{{layer.isToday}}">{{layer.clockText}}</text>
              <div class="today-btn" else onclick="onBackToday">
                <text class="today-btn-text">今</text>
              </div>
            </div>
            <text class="date-text">{{layer.dateText}}</text>

            <div class="card" if="{{layer.hasNext}}">
              <div class="row">
                <text class="blue">{{layer.nextLabel}}</text>
                <text class="strong-next">{{layer.nextName}}</text>
                <text class="blue">{{layer.nextCountdown}}</text>
              </div>
              <text class="meta">{{layer.nextMeta}}</text>
            </div>

            <block for="{{(groupIndex, group) in layer.groups}}">
              <div class="tag-wrap">
                <text class="tag">{{group.label}}</text>
              </div>
              <div class="card" for="{{(courseIndex, course) in group.courses}}">
                <div class="row">
                  <text class="strong">{{course.name}}</text>
                  <text class="blue">{{course.timeText}}</text>
                </div>
                <div class="row">
                  <text class="meta">{{course.meta}}</text>
                  <text class="meta">{{course.status}}</text>
                </div>
              </div>
            </block>

            <div class="empty-wrap" if="{{layer.showEmpty}}">
              <div class="empty-pill">
                <text class="empty-title">{{layer.emptyTitle}}</text>
                <text class="empty-sub" if="{{layer.showNeedPhone}}">{{layer.emptySub}}</text>
              </div>
            </div>
          </div>
        </scroll>
      </div>
    </stack>

    <scroll class="body" scroll-y="true" bounces="true" if="{{isAbout}}">
    <div class="screen screen-about">
      <text class="page-title">应用信息</text>

      <div class="card">
        <div class="row-app">
          <image class="app-icon" src="/common/about_icon.png"></image>
          <div class="app-text">
            <text class="app-name">nexio课程表</text>
            <text class="app-ver">版本: v1.0.0</text>
          </div>
        </div>
      </div>

      <text class="section-label">开发人员名单</text>

      <div class="card people-card">
        <div class="person">
          <image class="avatar" src="/common/photo1.png"></image>
          <div class="person-text">
            <text class="person-name">一個小果冻</text>
            <text class="person-role">快应用开发设计</text>
          </div>
        </div>
        <div class="person">
          <image class="avatar" src="/common/photo2.png"></image>
          <div class="person-text">
            <text class="person-name">Sunlight</text>
            <text class="person-role">nexio开发者</text>
          </div>
        </div>
      </div>

      <!-- 打赏入口：放在关于页最后 -->
      <div class="card entry-card" onclick="onOpenReward">
        <div class="entry-row">
          <text class="entry-label">打赏支持</text>
          <text class="entry-hint">扫码支持</text>
        </div>
      </div>
    </div>
    </scroll>

    <!-- ============ 打赏 ============ -->
    <scroll class="body" scroll-y="true" bounces="true" if="{{isReward}}">
      <!-- 打赏页：向右侧滑返回关于页 -->
      <div class="screen-reward" onswipe="onRewardSwipe">
        <div class="reward-head">
          <text class="reward-title">感谢打赏！</text>
          <text class="reward-title">谢谢喵！</text>
        </div>
        <div class="reward-card">
          <image class="reward-qr" src="/common/reward_qr.png"></image>
        </div>
      </div>
    </scroll>

    <div class="sys-back-edge" if="{{isHome}}"></div>
    </div>
    </stack>

    <div class="tab-bar">
      <div class="tab-btn" onclick="onTabHome">
        <div class="tab-slot">
          <div class="tab-hl tab-in-l" show="{{isHome}}">
            <image class="tab-icon" src="/common/tab_home.png"></image>
          </div>
          <div class="tab-hl-off tab-in-l" show="{{aboutActive}}">
            <image class="tab-icon" src="/common/tab_home.png"></image>
          </div>
        </div>
      </div>

      <div class="tab-btn" onclick="onTabAbout">
        <div class="tab-slot">
          <div class="tab-hl tab-in-r" show="{{aboutActive}}">
            <image class="tab-icon" src="/common/tab_about.png"></image>
          </div>
          <div class="tab-hl-off tab-in-r" show="{{isHome}}">
            <image class="tab-icon" src="/common/tab_about.png"></image>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import sync from '../../common/sync'
import schedule from '../../common/schedule'
import util from '../../common/util'

/** 出入场动画时长（ms），与 CSS animation-duration 一致 */
const SLIDE_MS = 280
/** 左缘留给系统「右滑回桌面」的宽度，与 .sys-back-edge 保持一致 */
const EDGE_W = 12

export default {
  private: {
    isHome: true,
    isAbout: false,
    isReward: false,
    /* 打赏页也算「关于」这一支：底部 Tab 保持高亮 */
    aboutActive: false,
    dayLayers: [],
    viewDateTs: 0
  },
  onInit() {
    this.unsubscribe = sync.onScheduleChange(() => {
      this.refreshHome()
    })
    sync.init()
    this.refreshHome()
    this._refreshTimer = setInterval(() => {
      this.refreshHome()
    }, 60000)
  },
  onShow() {
    this.refreshHome()
  },
  onDestroy() {
    this._pendingDelta = 0
    if (this._refreshTimer) {
      clearInterval(this._refreshTimer)
      this._refreshTimer = null
    }
    if (this._slideTimer) {
      clearTimeout(this._slideTimer)
      this._slideTimer = null
    }
    if (this.unsubscribe) {
      this.unsubscribe()
      this.unsubscribe = null
    }
  },
  getViewDate() {
    return this.viewDateTs ? new Date(this.viewDateTs) : new Date()
  },
  buildLayer(vm, now, layerClass) {
    return {
      layerClass: layerClass,
      isToday: vm.isToday,
      weekday: vm.isToday ? '今天是' + vm.weekday : vm.weekday,
      dateText: vm.dateText,
      clockText: util.formatClock(now),
      hasNext: vm.hasNext,
      nextLabel: vm.nextCourse ? vm.nextCourse.label : '下节课',
      nextName: vm.nextCourse ? vm.nextCourse.name : '',
      nextCountdown: vm.nextCourse ? vm.nextCourse.countdown : '',
      nextMeta: vm.nextCourse ? vm.nextCourse.meta : '',
      groups: vm.groups,
      showEmpty: !vm.hasCourses,
      showNeedPhone: vm.emptyState === 'need-phone',
      emptyTitle:
        vm.emptyState === 'need-phone'
          ? '请连接手机'
          : vm.emptyState === 'holiday'
            ? vm.isToday
              ? '今日是假期，好好休息吧'
              : '当天是假期，好好休息吧'
            : vm.isToday
              ? '今日无课'
              : '当天无课',
      emptySub: '打开Nexio课程表发送数据'
    }
  },
  refreshHome() {
    const now = new Date()
    const viewDate = this.getViewDate()
    const vm = schedule.buildHomeViewModel(viewDate, util, now)
    const layer = this.buildLayer(vm, now, '')
    // 滑动过程中不打断双层；只更新当前层数据
    if (this.dayLayers.length === 1) {
      this.dayLayers = [layer]
    } else if (this.dayLayers.length >= 2) {
      const next = this.dayLayers.slice()
      next[1] = Object.assign({}, next[1], {
        clockText: layer.clockText
      })
      this.dayLayers = next
    } else {
      this.dayLayers = [layer]
    }
  },
  /**
   * 切日。快速连滑时合并位移，保证同一时刻只存在一组出入场层，
   * 避免多层动画叠在一起乱飞。
   */
  goDay(delta) {
    this._pendingDelta = (this._pendingDelta || 0) + delta
    if (this._slideTimer) return
    this._runSlide()
  },
  _runSlide() {
    const delta = this._pendingDelta || 0
    this._pendingDelta = 0
    if (!delta) return

    const now = new Date()
    const oldDate = this.getViewDate()
    const oldVm = schedule.buildHomeViewModel(oldDate, util, now)
    const newDate = util.addDays(oldDate, delta)
    const newVm = schedule.buildHomeViewModel(newDate, util, now)

    // 净位移方向决定滑入边：向后→新页从右侧进，向前→从左侧进
    const goingNext = delta > 0
    const outClass = goingNext ? 'layer-out-left' : 'layer-out-right'
    const inClass = goingNext ? 'layer-in-right' : 'layer-in-left'

    this.dayLayers = [
      this.buildLayer(oldVm, now, outClass),
      this.buildLayer(newVm, now, inClass)
    ]
    this.viewDateTs = newDate.getTime()

    this._slideTimer = setTimeout(() => {
      this._slideTimer = null
      const cur = schedule.buildHomeViewModel(this.getViewDate(), util, new Date())
      this.dayLayers = [this.buildLayer(cur, new Date(), '')]
      // 动画期间攒下的滑动，合并后再播下一段
      if (this._pendingDelta) this._runSlide()
    }, SLIDE_MS)
  },
  onBackToday() {
    this._pendingDelta = 0
    if (this._slideTimer) {
      clearTimeout(this._slideTimer)
      this._slideTimer = null
    }
    this.viewDateTs = 0
    this.refreshHome()
  },
  touchXY(t) {
    if (!t) return null
    const x = t.clientX != null ? t.clientX : t.pageX != null ? t.pageX : t.x
    const y = t.clientY != null ? t.clientY : t.pageY != null ? t.pageY : t.y
    if (x == null || y == null) return null
    return { x: x, y: y }
  },
  onTouchStart(e) {
    const t = e && e.touches && e.touches[0]
    const p = this.touchXY(t)
    // 左缘起手不切日，留给系统「右滑回桌面」
    this._touchFromEdge = !!(p && p.x <= EDGE_W)
    // 同一手势只允许触发一次切日（出入场双层都会挂 handler）
    this._gestureSwiped = false
  },
  onSwipe(e) {
    // 左缘起手的滑动交给系统返回，应用内不响应
    if (this._touchFromEdge) {
      this._touchFromEdge = false
      return
    }
    if (this._gestureSwiped) return
    this._gestureSwiped = true
    const dir = e && e.direction
    if (dir === 'left') {
      this.goDay(1)
    } else if (dir === 'right') {
      this.goDay(-1)
    }
  },
  onTabHome() {
    this.isHome = true
    this.isAbout = false
    this.isReward = false
    this.aboutActive = false
    this.refreshHome()
  },
  onTabAbout() {
    this.isHome = false
    this.isAbout = true
    this.isReward = false
    this.aboutActive = true
  },
  /** 关于页 → 打赏页 */
  onOpenReward() {
    this.isHome = false
    this.isAbout = false
    this.isReward = true
    this.aboutActive = true
  },
  /** 打赏页向右侧滑返回关于页 */
  onRewardSwipe(e) {
    if (e && e.direction === 'right') {
      this.isReward = false
      this.isAbout = true
      this.aboutActive = true
    }
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }

  .page-stack {
    width: 100%;
    height: 100%;
  }

  /* 固定两层：内容层在下、tab-bar 在上，避免 if/else 重建后层级颠倒 */
  .body-layer {
    width: 100%;
    height: 100%;
    flex-direction: column;
    position: relative;
  }

  /* 左缘透明条：盖住应用横滑，系统「右滑回桌面」才能生效（宽度与 EDGE_W 一致） */
  .sys-back-edge {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 10px;
    height: 100%;
    background-color: transparent;
  }

  /* 整页横滑舞台：裁切出屏内容 */
  .day-stage {
    width: 100%;
    height: 100%;
    overflow: hidden;
    flex-direction: column;
  }

  .day-layer {
    width: 100%;
    height: 100%;
  }

  /* 出场：向左/右整页滑出 */
  .layer-out-left {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    animation-name: layerOutLeft;
    animation-duration: 280ms;
    animation-timing-function: ease-out;
    animation-fill-mode: forwards;
  }

  .layer-out-right {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    animation-name: layerOutRight;
    animation-duration: 280ms;
    animation-timing-function: ease-out;
    animation-fill-mode: forwards;
  }

  /* 入场：从右/左整页滑入 */
  .layer-in-right {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    animation-name: layerInRight;
    animation-duration: 280ms;
    animation-timing-function: ease-out;
    animation-fill-mode: forwards;
  }

  .layer-in-left {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    animation-name: layerInLeft;
    animation-duration: 280ms;
    animation-timing-function: ease-out;
    animation-fill-mode: forwards;
  }

  @keyframes layerOutLeft {
    0% {
      transform: translateX(0px);
    }
    100% {
      transform: translateX(-336px);
    }
  }

  @keyframes layerOutRight {
    0% {
      transform: translateX(0px);
    }
    100% {
      transform: translateX(336px);
    }
  }

  @keyframes layerInRight {
    0% {
      transform: translateX(336px);
    }
    100% {
      transform: translateX(0px);
    }
  }

  @keyframes layerInLeft {
    0% {
      transform: translateX(-336px);
    }
    100% {
      transform: translateX(0px);
    }
  }

  .body {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
  }

  .screen {
    width: 100%;
    flex-direction: column;
    padding-top: 28px;
    padding-right: 10px;
    padding-bottom: 110px;
    padding-left: 10px;
    /* 保证可滚动/回弹：内容不足一屏时也有滚动高度 */
    min-height: 520px;
  }

  /* 标题区约 114px，height=240 使文案中心落在屏幕垂直中线附近 */
  .empty-wrap {
    width: 100%;
    height: 220px;
    justify-content: center;
    align-items: center;
  }

  .empty-pill {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #242424;
    border-radius: 18px;
    padding-top: 14px;
    padding-right: 24px;
    padding-bottom: 14px;
    padding-left: 24px;
  }

  .empty-title {
    font-size: 20px;
    font-weight: bold;
    color: #d1d1d6;
    text-align: center;
  }

  .empty-sub {
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
    text-align: center;
    margin-top: 6px;
    lines: -1;
  }

  .header-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
    overflow: visible;
  }

  .weekday {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 30px;
    font-weight: bold;
    color: #ffffff;
    lines: 1;
  }

  .clock {
    width: 88px;
    height: 38px;
    flex-shrink: 0;
    font-size: 26px;
    font-weight: bold;
    color: #ffffff;
    margin-left: 6px;
    text-align: right;
    lines: 1;
  }

  /* 与时间同宽，避免右上角错位 */
  .today-btn {
    width: 88px;
    height: 38px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    background-color: #242424;
    border-radius: 30px;
    margin-left: 6px;
  }

  .today-btn-text {
    font-size: 20px;
    font-weight: bold;
    color: #3381FF;
    text-align: center;
    lines: 1;
  }

  .date-text {
    width: 100%;
    font-size: 30px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 16px;
    lines: 1;
  }

  .card {
    width: 100%;
    flex-direction: column;
    padding-top: 14px;
    padding-right: 12px;
    padding-bottom: 14px;
    padding-left: 12px;
    background-color: #242424;
    border-radius: 16px;
    margin-bottom: 12px;
    overflow: visible;
  }

  .row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 0;
    overflow: visible;
  }

  /* 「下节课」+ 课名紧挨左侧，倒计时由 .row 的 space-between 顶到最右 */
  .row-left {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    flex-shrink: 1;
  }

  /* 下节课课名：中间弹性区，长课名折行；min-width 防止被挤成竖排 */
  .strong-next {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 96px;
    lines: -1;
    font-size: 22px;
    font-weight: bold;
    margin-left: 6px;
    margin-right: 6px;
    margin-bottom: 5px;
    color: #ffffff;
    overflow: visible;
  }

  /* 列表课名 */
  .strong {
    font-size: 22px;
    font-weight: bold;
    width: 100%;
    margin-left: 2px;
    margin-right: 5px;
    margin-bottom: 5px;
    color: #ffffff;
  }

  .blue {
    font-size: 18px;
    font-weight: bold;
    flex-shrink: 0;
    margin-bottom: 5px;
    color: #3381FF;
  }

  .meta {
    font-size: 17px;
    font-weight: bold;
    color: #8e8e93;
    lines: -1;
  }

  .tag-wrap {
    width: 100%;
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 9px;
  }

  .tag {
    font-size: 15px;
    font-weight: bold;
    color: #d1d1d6;
    background-color: #242424;
    border-radius: 8px;
    padding-top: 4px;
    padding-right: 10px;
    padding-bottom: 4px;
    padding-left: 10px;
  }

  /* 仅增加可滚高度以触发回弹，不改变关于页内部布局 */
  .screen-about {
    min-height: 620px;
  }

  .page-title {
    width: 100%;
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 14px;
  }

  .row-app {
    width: 100%;
    flex-direction: row;
  }

  .app-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    margin-right: 12px;
  }

  .app-text {
    flex-direction: column;
  }

  .app-name {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .app-ver {
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
  }

  .section-label {
    width: 100%;
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
    margin-top: 6px;
    margin-bottom: 8px;
  }

  .person {
    width: 100%;
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
  }

  /* 人员卡：行距作底部留白，避免双倍 */
  .people-card {
    padding-top: 14px;
    padding-bottom: 0px;
  }

  /* 图已预裁圆形透明边，勿再用 border-radius 二次硬裁 */
  .avatar {
    width: 46px;
    height: 46px;
    background-color: transparent;
    margin-right: 12px;
  }

  .person-text {
    flex: 1;
    flex-direction: column;
    align-items: flex-end;
  }

  .person-name {
    width: 100%;
    text-align: left;
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 4px;
    margin-left: 5px;
  }

  .person-role {
    width: 100%;
    text-align: left;
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
    margin-left: 5px;
  }

  /* 悬浮 Tab：原样紧凑胶囊，宽高各 +10px 等比放大，不横向拉伸 */
  .tab-bar {
    position: absolute;
    left: 95px;
    right: 95px;
    bottom: 30px;
    height: 65px;
    flex-direction: row;
    background-color: #282828;
    border-radius: 40px;
    align-items: center;
    overflow: visible;
    box-shadow: 0px 6px 18px rgba(0, 0, 0, 0.18);
  }

  .tab-btn {
    width: 50%;
    height: 65px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  /* 固定插槽，避免选中态被压成圆点 */
  .tab-slot {
    width: 65px;
    height: 55px;
    margin-top: -1px;
    overflow: visible;
  }

  /* 选中：比外框小一圈的嵌套胶囊 */
  .tab-hl {
    width: 65px;
    height: 55px;
    min-width: 65px;
    min-height: 55px;
    position: absolute;
    left: 0px;
    top: 0px;
    border-radius: 40px;
    background-color: #353535;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  /* 未选中：同尺寸透明占位，避免图标跳动 */
  .tab-hl-off {
    width: 65px;
    height: 55px;
    min-width: 65px;
    min-height: 55px;
    position: absolute;
