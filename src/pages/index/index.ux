<template>
  <div class="page">
    <stack class="page-stack">
    <div class="body-layer">
    <scroll class="body" scroll-y="true" bounces="true" if="{{isHome}}">
    <div class="screen">
      <text class="weekday">{{weekday}}</text>
      <text class="date-text">{{dateText}}</text>

      <div class="card" if="{{hasNext}}">
        <div class="row">
          <text class="blue">下节课</text>
          <text class="strong-next">{{nextName}}</text>
          <text class="blue">{{nextCountdown}}</text>
        </div>
        <text class="meta">{{nextMeta}}</text>
      </div>

      <block for="{{(groupIndex, group) in groups}}">
        <div class="tag-wrap">
          <text class="tag">{{group.label}}</text>
        </div>
        <div class="card" for="{{(courseIndex, course) in group.courses}}">
          <div class="row">
            <text class="strong">{{course.name}}</text>
            <text class="blue">{{course.timeText}}</text>
          </div>
          <div class="row">
            <text class="meta">{{course.meta}}</text>
            <text class="meta">{{course.status}}</text>
          </div>
        </div>
      </block>

      <div class="empty-wrap" if="{{showEmpty}}">
        <div class="empty-pill">
          <text class="empty-title">{{emptyTitle}}</text>
          <text class="empty-sub" if="{{showNeedPhone}}">{{emptySub}}</text>
        </div>
      </div>
    </div>
    </scroll>

    <scroll class="body" scroll-y="true" bounces="true" else>
    <div class="screen screen-about">
      <text class="page-title">应用信息</text>

      <div class="card">
        <div class="row-app">
          <image class="app-icon" src="/common/about_icon.png"></image>
          <div class="app-text">
            <text class="app-name">nexio课程表</text>
            <text class="app-ver">版本: v1.0.1</text>
          </div>
        </div>
      </div>

      <text class="section-label">开发人员名单</text>

      <div class="card people-card">
        <div class="person">
          <image class="avatar" src="/common/photo1.png"></image>
          <div class="person-text">
            <text class="person-name">一個小果冻</text>
            <text class="person-role">快应用开发设计</text>
          </div>
        </div>
        <div class="person">
          <image class="avatar" src="/common/photo2.png"></image>
          <div class="person-text">
            <text class="person-name">Sunlight</text>
            <text class="person-role">nexio开发者</text>
          </div>
        </div>
      </div>
    </div>
    </scroll>
    </div>
    </stack>

    <div class="tab-bar">
      <div class="tab-btn" onclick="onTabHome">
        <div class="tab-slot">
          <div class="tab-hl tab-in-l" show="{{isHome}}">
            <image class="tab-icon" src="/common/tab_home.png"></image>
          </div>
          <div class="tab-hl-off tab-in-l" show="{{isAbout}}">
            <image class="tab-icon" src="/common/tab_home.png"></image>
          </div>
        </div>
      </div>

      <div class="tab-btn" onclick="onTabAbout">
        <div class="tab-slot">
          <div class="tab-hl tab-in-r" show="{{isAbout}}">
            <image class="tab-icon" src="/common/tab_about.png"></image>
          </div>
          <div class="tab-hl-off tab-in-r" show="{{isHome}}">
            <image class="tab-icon" src="/common/tab_about.png"></image>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import sync from '../../common/sync'
import schedule from '../../common/schedule'
import util from '../../common/util'

export default {
  private: {
    isHome: true,
    isAbout: false,
    weekday: '今天是周日',
    dateText: '',
    hasNext: false,
    nextName: '',
    nextCountdown: '',
    nextMeta: '',
    groups: [],
    showEmpty: false,
    showNeedPhone: false,
    emptyTitle: '今日无课',
    emptySub: '打开Nexio课程表发送数据'
  },
  onInit() {
    this.unsubscribe = sync.onScheduleChange(() => {
      this.refreshHome()
    })
    sync.init()
    this.refreshHome()
    this._refreshTimer = setInterval(() => {
      this.refreshHome()
    }, 60000)
  },
  onShow() {
    this.refreshHome()
  },
  onDestroy() {
    if (this._refreshTimer) {
      clearInterval(this._refreshTimer)
      this._refreshTimer = null
    }
    if (this.unsubscribe) {
      this.unsubscribe()
      this.unsubscribe = null
    }
  },
  refreshHome() {
    const vm = schedule.buildHomeViewModel(new Date(), util)
    this.weekday = '今天是' + vm.weekday
    this.dateText = vm.dateText
    this.hasNext = vm.hasNext
    if (vm.nextCourse) {
      this.nextName = vm.nextCourse.name
      this.nextCountdown = vm.nextCourse.countdown
      this.nextMeta = vm.nextCourse.meta
    } else {
      this.nextName = ''
      this.nextCountdown = ''
      this.nextMeta = ''
    }
    this.groups = vm.groups
    this.showEmpty = !vm.hasCourses
    this.showNeedPhone = vm.emptyState === 'need-phone'
    if (vm.emptyState === 'need-phone') {
      this.emptyTitle = '请连接手机'
      this.emptySub = '打开Nexio课程表发送数据'
    } else if (vm.emptyState === 'no-class') {
      this.emptyTitle = '今日无课'
      this.emptySub = ''
    }
  },
  onTabHome() {
    this.isHome = true
    this.isAbout = false
    this.refreshHome()
  },
  onTabAbout() {
    this.isHome = false
    this.isAbout = true
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }

  .page-stack {
    width: 100%;
    height: 100%;
  }

  /* 固定两层：内容层在下、tab-bar 在上，避免 if/else 重建后层级颠倒 */
  .body-layer {
    width: 100%;
    height: 100%;
    flex-direction: column;
  }

  .body {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
  }

  .screen {
    width: 100%;
    flex-direction: column;
    padding-top: 28px;
    padding-right: 10px;
    padding-bottom: 110px;
    padding-left: 10px;
    /* 保证可滚动/回弹：内容不足一屏时也有滚动高度 */
    min-height: 520px;
  }

  /* 仅增加可滚高度以触发回弹，不改变关于页内部布局 */
  .screen-about {
    min-height: 620px;
  }

  /* 标题区约 114px，height=240 使文案中心落在屏幕垂直中线附近 */
  .empty-wrap {
    width: 100%;
    height: 220px;
    justify-content: center;
    align-items: center;
  }

  .empty-pill {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #2c2c2e;
    border-radius: 18px;
    padding-top: 14px;
    padding-right: 24px;
    padding-bottom: 14px;
    padding-left: 24px;
  }

  .empty-title {
    font-size: 20px;
    font-weight: bold;
    color: #d1d1d6;
    text-align: center;
  }

  .empty-sub {
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
    text-align: center;
    margin-top: 6px;
    lines: -1;
  }

  .weekday {
    width: 100%;
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .date-text {
    width: 100%;
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .page-title {
    width: 100%;
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 14px;
  }

  .card {
    width: 100%;
    flex-direction: column;
    padding-top: 14px;
    padding-right: 12px;
    padding-bottom: 14px;
    padding-left: 12px;
    background-color: #2c2c2e;
    border-radius: 16px;
    margin-bottom: 12px;
    overflow: visible;
  }

  .row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 0;
    overflow: visible;
  }

  /* 「下节课」+ 课名紧挨左侧，倒计时由 .row 的 space-between 顶到最右 */
  .row-left {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    flex-shrink: 1;
  }

  .row-app {
    width: 100%;
    flex-direction: row;
  }

  .app-icon {
    width: 48px;
