<template>
  <div class="page">
    <stack class="page-stack">
    <div class="body-layer">
    <!-- 单层常驻结构：切日只换数据、不重建任何节点。
         Vela 3.6（小米手环 9 Pro）上重建带 scroll 的层节点会导致整屏黑且点不动，
         所以这里没有双层、没有 for 复用、没有动画，切日只更新下面这些绑定。 -->
    <scroll class="body" scroll-y="true" bounces="true" if="{{isHome}}">
      <div class="screen" onswipe="onSwipe" ontouchstart="onTouchStart">
        <div class="header-row">
          <text class="weekday">{{day.weekday}}</text>
          <text class="clock" if="{{day.isToday}}">{{day.clockText}}</text>
          <div class="today-btn" else onclick="onBackToday">
            <text class="today-btn-text">今</text>
          </div>
        </div>
        <text class="date-text">{{day.dateText}}</text>

        <div class="card" if="{{day.hasNext}}">
          <div class="row">
            <text class="blue">{{day.nextLabel}}</text>
            <text class="strong-next">{{day.nextName}}</text>
            <text class="blue">{{day.nextCountdown}}</text>
          </div>
          <text class="meta">{{day.nextMeta}}</text>
        </div>

        <block for="{{(groupIndex, group) in day.groups}}">
          <div class="tag-wrap">
            <text class="tag">{{group.label}}</text>
          </div>
          <div class="card" for="{{(courseIndex, course) in group.courses}}">
            <div class="row">
              <text class="strong">{{course.name}}</text>
              <text class="blue">{{course.timeText}}</text>
            </div>
            <div class="row">
              <text class="meta">{{course.meta}}</text>
              <text class="meta">{{course.status}}</text>
            </div>
          </div>
        </block>

        <div class="empty-wrap" if="{{day.showEmpty}}">
          <div class="empty-pill">
            <text class="empty-title">{{day.emptyTitle}}</text>
            <text class="empty-sub" if="{{day.showNeedPhone}}">{{day.emptySub}}</text>
          </div>
        </div>
      </div>
    </scroll>

    <scroll class="body" scroll-y="true" bounces="true" if="{{isAbout}}">
    <div class="screen screen-about">
      <text class="page-title">应用信息</text>

      <div class="card">
        <div class="row-app">
          <image class="app-icon" src="/common/about_icon.png"></image>
          <div class="app-text">
            <text class="app-name">nexio课程表</text>
            <text class="app-ver">版本：v{{versionName}}</text>
          </div>
        </div>
      </div>

      <!-- 同步日志：连接状态 + 最近本地更新时间（对齐设计稿） -->
      <div class="card diag-card">
        <text class="diag-status">{{diagStatus}}</text>
        <text class="diag-sub">{{diagUpdated}}</text>
      </div>

      <text class="section-label">开发人员名单</text>

      <div class="card people-card">
        <div class="person">
          <image class="avatar" src="/common/photo1.png"></image>
          <div class="person-text">
            <text class="person-name">一個小果冻</text>
            <text class="person-role">快应用开发设计</text>
          </div>
        </div>
        <div class="person">
          <image class="avatar" src="/common/photo2.png"></image>
          <div class="person-text">
            <text class="person-name">Sunlight</text>
            <text class="person-role">原nexio开发者</text>
          </div>
        </div>
      </div>

      <!-- 打赏入口：放在关于页最后 -->
      <div class="card entry-card" onclick="onOpenReward">
        <div class="entry-row">
          <text class="entry-label">打赏支持</text>
          <text class="entry-hint">扫码支持</text>
        </div>
      </div>
    </div>
    </scroll>

    <!-- ============ 打赏 ============ -->
    <scroll class="body" scroll-y="true" bounces="true" if="{{isReward}}">
      <!-- 打赏页：向右侧滑返回关于页 -->
      <div class="screen-reward" onswipe="onRewardSwipe">
        <div class="reward-head">
          <text class="reward-title">感谢打赏！</text>
          <text class="reward-title">谢谢喵！</text>
        </div>
        <div class="reward-card">
          <image class="reward-qr" src="/common/reward_qr.png"></image>
        </div>
      </div>
    </scroll>

    <div class="sys-back-edge" if="{{isHome}}"></div>
    </div>
    </stack>

    <div class="tab-bar">
      <div class="tab-btn" onclick="onTabHome">
        <div class="tab-slot">
          <div class="tab-hl tab-in-l" show="{{isHome}}">
            <image class="tab-icon" src="/common/tab_home.png"></image>
          </div>
          <div class="tab-hl-off tab-in-l" show="{{aboutActive}}">
            <image class="tab-icon" src="/common/tab_home.png"></image>
          </div>
        </div>
      </div>

      <div class="tab-btn" onclick="onTabAbout">
        <div class="tab-slot">
          <div class="tab-hl tab-in-r" show="{{aboutActive}}">
            <image class="tab-icon" src="/common/tab_about.png"></image>
          </div>
          <div class="tab-hl-off tab-in-r" show="{{isHome}}">
            <image class="tab-icon" src="/common/tab_about.png"></image>
          </div>
        </div>
      </div>
    </div>

    <!-- 连接提示：常驻节点只切换可见性（Vela 3.6 避免重建节点），位置在悬浮 Tab 上方 15px -->
    <div class="toast" show="{{toastVisible}}">
      <text class="toast-text">{{toastText}}</text>
    </div>
  </div>
</template>

<script>
import sync from '../../common/sync'
import schedule from '../../common/schedule'
import util from '../../common/util'
import device from '@system.device'

/** 左缘留给系统「右滑回桌面」的宽度，与 .sys-back-edge 保持一致 */
const EDGE_W = 12

export default {
  private: {
    isHome: true,
    isAbout: false,
    isReward: false,
    /* 打赏页也算「关于」这一支：底部 Tab 保持高亮 */
    aboutActive: false,
    /* 当前展示的那一天（单层常驻，切日只换这个对象） */
    day: {},
    viewDateTs: 0,
    /* 与 manifest.json 的 versionName 保持一致 */
    versionName: '1.1.2',
    /* 同步日志（关于页展示） */
    diagStatus: '',
    diagUpdated: '',
    /* 页面内连接提示（悬浮 Tab 上方） */
    toastText: '',
    toastVisible: false
  },
  onInit() {
    this.unsubscribe = sync.onScheduleChange(() => {
      this.refreshHome()
      this.refreshDiagnostics()
    })
    this.unsubscribeToast = sync.onToast((message) => {
      this.showPageToast(message)
    })
    sync.init()
    this.probePlatform()
    this.refreshHome()
    this.refreshDiagnostics()
    this._refreshTimer = setInterval(() => {
      this.refreshHome()
    }, 60000)
  },
  onShow() {
    this.refreshHome()
    this.refreshDiagnostics()
    // 数据过期就主动向手机拉一次，别等手机那边点推送
    sync.ensureFresh('show')
  },
  onDestroy() {
    if (this._refreshTimer) {
      clearInterval(this._refreshTimer)
      this._refreshTimer = null
    }
    if (this.unsubscribe) {
      this.unsubscribe()
      this.unsubscribe = null
    }
    if (this.unsubscribeToast) {
      this.unsubscribeToast()
      this.unsubscribeToast = null
    }
    if (this._toastTimer) {
      clearTimeout(this._toastTimer)
      this._toastTimer = null
    }
  },
  /**
   * 页面内 toast：系统 showToast 固定居中且不可定位，
   * 这里用常驻节点切换可见性，落在悬浮 Tab 上方 15px。
   */
  showPageToast(message) {
    this.toastText = message
    this.toastVisible = true
    if (this._toastTimer) clearTimeout(this._toastTimer)
    this._toastTimer = setTimeout(() => {
      this.toastVisible = false
      this._toastTimer = null
    }, 2000)
  },
  getViewDate() {
    return this.viewDateTs ? new Date(this.viewDateTs) : new Date()
  },
  /**
   * 同步日志（关于页）：按设计稿只保留两行——
   * 连接状态 + 最近一次本地更新时间。
   */
  refreshDiagnostics() {
    const s = sync.getStatus()
    this.diagStatus = s.ready ? '已连接手机' : '手机未连接'
    this.diagUpdated =
      '最近一次本地更新时间：' + (s.lastAt ? util.formatClock(new Date(s.lastAt)) : '--:--')
  },
  buildDay(vm, now) {
    return {
      isToday: vm.isToday,
      weekday: vm.isToday ? '今天是' + vm.weekday : vm.weekday,
      dateText: vm.dateText,
      clockText: util.formatClock(now),
      hasNext: vm.hasNext,
      nextLabel: vm.nextCourse ? vm.nextCourse.label : '下节课',
      nextName: vm.nextCourse ? vm.nextCourse.name : '',
      nextCountdown: vm.nextCourse ? vm.nextCourse.countdown : '',
      nextMeta: vm.nextCourse ? vm.nextCourse.meta : '',
      groups: vm.groups,
      showEmpty: !vm.hasCourses,
      showNeedPhone: vm.emptyState === 'need-phone',
      emptyTitle:
      vm.emptyState === 'need-phone'
          ? '请连接手机'
          : vm.emptyState === 'holiday'
            ? vm.isToday
              ? '今天是假期，好好休息吧'
              : '这天是假期'
            : vm.isToday
              ? '今日无课'
              : '这天没有课程',
      emptySub: '打开Nexio课程表发送数据'
    }
  },
  refreshHome() {
    const now = new Date()
    const viewDate = this.getViewDate()
    const vm = schedule.buildHomeViewModel(viewDate, util, now)
    // 单层常驻：只替换这一个对象的内容，既不改节点结构也不做动画
    this.day = this.buildDay(vm, now)
  },
  /**
   * 读平台版本（Vela）与 APILevel，仅用于关于页的「同步诊断」展示。
   * 小米手环 9 Pro 是 Vela 3.6，平台信息能帮助定位机型差异。
   */
  probePlatform() {
    this._platform = '-'
    this._platform = '-'
    try {
      device.getInfo({
        success: (info) => {
          const name = (info && (info.platformVersionName || info.osVersionName)) || ''
          this._platform = name + (info && info.APILevel != null ? ' / api' + info.APILevel : '')
          console.log('[page] platform=' + name)
          this.refreshDiagnostics()
        },
        fail: () => {
          this.refreshDiagnostics()
        }
      })
    } catch (e) {
      console.log('[page] device.getInfo fail', e)
    }
  },
  /**
   * 切日：只换数据，不重建节点、不做动画。
   * Vela 3.6（小米手环 9 Pro）上重建带 scroll 的层节点会整屏黑且点不动，
   * 因此这里彻底去掉双层与出入场动画 —— 兼容优先。
   */
  goDay(delta) {
    this._swipeCount = (this._swipeCount || 0) + 1
    let target = util.addDays(this.getViewDate(), delta)
    // v2 兼容（无整表数据）：14 天后的课表推不准（单双周无法判定），不再能滑动。
    // 整表（version=4）模式下有完整学期数据，不限制。
    if (!schedule.hasFullSemester()) {
      const limit = util.addDays(new Date(), 14).getTime()
      if (target.getTime() > limit) {
        if (this.getViewDate().getTime() >= limit) return
        target = new Date(limit)
      }
    }
    this.viewDateTs = target.getTime()
    this.refreshHome()
    this.refreshDiagnostics()
  },
  onBackToday() {
    this.viewDateTs = 0
    this.refreshHome()
  },
  touchXY(t) {
    if (!t) return null
    const x = t.clientX != null ? t.clientX : t.pageX != null ? t.pageX : t.x
    const y = t.clientY != null ? t.clientY : t.pageY != null ? t.pageY : t.y
    if (x == null || y == null) return null
    return { x: x, y: y }
  },
  onTouchStart(e) {
    const t = e && e.touches && e.touches[0]
    const p = this.touchXY(t)
    // 左缘起手不切日，留给系统「右滑回桌面」
    this._touchFromEdge = !!(p && p.x <= EDGE_W)
    // 同一手势只允许触发一次切日（出入场双层都会挂 handler）
    this._gestureSwiped = false
  },
  onSwipe(e) {
    // 左缘起手的滑动交给系统返回，应用内不响应
    if (this._touchFromEdge) {
      this._touchFromEdge = false
      return
    }
    if (this._gestureSwiped) return
    this._gestureSwiped = true
    const dir = e && e.direction
    if (dir === 'left') {
      this.goDay(1)
    } else if (dir === 'right') {
      this.goDay(-1)
    }
  },
  onTabHome() {
    this.isHome = true
    this.isAbout = false
    this.isReward = false
    this.aboutActive = false
    this.refreshHome()
  },
  onTabAbout() {
    this.isHome = false
    this.isAbout = true
    this.isReward = false
    this.aboutActive = true
  },
  /** 关于页 → 打赏页 */
  onOpenReward() {
    this.isHome = false
    this.isAbout = false
    this.isReward = true
    this.aboutActive = true
  },
  /** 打赏页向右侧滑返回关于页 */
  onRewardSwipe(e) {
    if (e && e.direction === 'right') {
      this.isReward = false
      this.isAbout = true
      this.aboutActive = true
    }
  }
}
</script>

<style>
  .page {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }

  .page-stack {
    width: 100%;
    height: 100%;
  }

  /* 固定两层：内容层在下、tab-bar 在上，避免 if/else 重建后层级颠倒 */
  .body-layer {
    width: 100%;
    height: 100%;
    flex-direction: column;
    position: relative;
  }

  /* 左缘透明条：盖住应用横滑，系统「右滑回桌面」才能生效（宽度与 EDGE_W 一致） */
  .sys-back-edge {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 10px;
    height: 100%;
    background-color: transparent;
  }

  /* 切日不再有整页滑动动画，也没有双层与裁切舞台（Vela 3.6 上重建 scroll 层会黑屏）。
     现在只有一个常驻的 .body(滚动容器) + .screen(内容)，切日只更新数据绑定。 */

  .body {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
  }

  .screen {
    width: 100%;
    flex-direction: column;
    padding-top: 28px;
    padding-right: 10px;
    padding-bottom: 110px;
    padding-left: 10px;
    /* 保证可滚动/回弹：内容不足一屏时也有滚动高度 */
    min-height: 520px;
  }

  /* 标题区约 114px，height=240 使文案中心落在屏幕垂直中线附近 */
  .empty-wrap {
    width: 100%;
    height: 220px;
    justify-content: center;
    align-items: center;
  }

  .empty-pill {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #242424;
    border-radius: 18px;
    padding-top: 14px;
    padding-right: 24px;
    padding-bottom: 14px;
    padding-left: 24px;
  }

  .empty-title {
    font-size: 20px;
    font-weight: bold;
    color: #d1d1d6;
    text-align: center;
  }

  .empty-sub {
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
    text-align: center;
    margin-top: 6px;
    lines: -1;
  }

  .header-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
    overflow: visible;
  }

  .weekday {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 30px;
    font-weight: bold;
    color: #ffffff;
    lines: 1;
  }

  .clock {
    width: 88px;
    height: 38px;
    flex-shrink: 0;
    font-size: 26px;
    font-weight: bold;
    color: #ffffff;
    margin-left: 6px;
    text-align: right;
    lines: 1;
  }

  /* 与时间同宽，避免右上角错位 */
  .today-btn {
    width: 88px;
    height: 38px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    background-color: #242424;
    border-radius: 30px;
    margin-left: 6px;
  }

  .today-btn-text {
    font-size: 20px;
    font-weight: bold;
    color: #3381FF;
    text-align: center;
    lines: 1;
  }

  .date-text {
    width: 100%;
    font-size: 30px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 16px;
    lines: 1;
  }

  .card {
    width: 100%;
    flex-direction: column;
    padding-top: 14px;
    padding-right: 12px;
    padding-bottom: 14px;
    padding-left: 12px;
    background-color: #242424;
    border-radius: 16px;
    margin-bottom: 12px;
    overflow: visible;
  }

  .row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 0;
    overflow: visible;
  }

  /* 「下节课」+ 课名紧挨左侧，倒计时由 .row 的 space-between 顶到最右 */
  .row-left {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    flex-shrink: 1;
  }

  /* 下节课课名：中间弹性区，长课名折行；min-width 防止被挤成竖排 */
  .strong-next {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 96px;
    lines: -1;
    font-size: 22px;
    font-weight: bold;
    margin-left: 6px;
    margin-right: 6px;
    margin-bottom: 5px;
    color: #ffffff;
    overflow: visible;
  }

  /* 列表课名 */
  .strong {
    font-size: 22px;
    font-weight: bold;
    width: 100%;
    margin-left: 2px;
    margin-right: 5px;
    margin-bottom: 5px;
    color: #ffffff;
  }

  .blue {
    font-size: 18px;
    font-weight: bold;
    flex-shrink: 0;
    margin-bottom: 5px;
    color: #3381FF;
  }

  .meta {
    font-size: 17px;
    font-weight: bold;
    color: #8e8e93;
    lines: -1;
  }

  .tag-wrap {
    width: 100%;
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 9px;
  }

  .tag {
    font-size: 15px;
    font-weight: bold;
    color: #d1d1d6;
    background-color: #242424;
    border-radius: 8px;
    padding-top: 4px;
    padding-right: 10px;
    padding-bottom: 4px;
    padding-left: 10px;
  }

  /* 仅增加可滚高度以触发回弹，不改变关于页内部布局 */
  .screen-about {
    min-height: 620px;
  }

  .page-title {
    width: 100%;
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 14px;
  }

  .row-app {
    width: 100%;
    flex-direction: row;
  }

  .app-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    margin-right: 12px;
  }

  .app-text {
    flex-direction: column;
  }

  .app-name {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .app-ver {
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
  }

  /* 同步日志卡：状态行大号白字，明细行灰色小字（对齐设计稿） */
  .diag-status {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .diag-sub {
    font-size: 13px;
    color: #8e8e93;
    margin-bottom: 2px;
  }

  .section-label {
    width: 100%;
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
    margin-top: 6px;
    margin-bottom: 8px;
  }

  .person {
    width: 100%;
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
  }

  /* 人员卡：行距作底部留白，避免双倍 */
  .people-card {
    padding-top: 14px;
    padding-bottom: 0px;
  }

  /* 图已预裁圆形透明边，勿再用 border-radius 二次硬裁 */
  .avatar {
    width: 46px;
    height: 46px;
    background-color: transparent;
    margin-right: 12px;
  }

  .person-text {
    flex: 1;
    flex-direction: column;
    align-items: flex-end;
  }

  .person-name {
    width: 100%;
    text-align: left;
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 4px;
    margin-left: 5px;
  }

  .person-role {
    width: 100%;
    text-align: left;
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
    margin-left: 5px;
  }

  /* 悬浮 Tab：原样紧凑胶囊，宽高各 +10px 等比放大，不横向拉伸 */
  .tab-bar {
    position: absolute;
    left: 95px;
    right: 95px;
    bottom: 30px;
    height: 65px;
    flex-direction: row;
    background-color: #282828;
    border-radius: 40px;
    align-items: center;
    overflow: visible;
    box-shadow: 0px 6px 18px rgba(0, 0, 0, 0.18);
  }

  .tab-btn {
    width: 50%;
    height: 65px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  /* 固定插槽，避免选中态被压成圆点 */
  .tab-slot {
    width: 65px;
