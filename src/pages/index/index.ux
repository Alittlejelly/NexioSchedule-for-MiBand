    color: #d1d1d6;
    background-color: #2c2c2e;
    border-radius: 8px;
    padding-top: 4px;
    padding-right: 10px;
    padding-bottom: 4px;
    padding-left: 10px;
  }

  /* 悬浮 Tab：原样紧凑胶囊，宽高各 +10px 等比放大，不横向拉伸 */
  .tab-bar {
    position: absolute;
    left: 95px;
    right: 95px;
    bottom: 30px;
    height: 65px;
    flex-direction: row;
    background-color: #2c2c2e;
    border-radius: 40px;
    align-items: center;
    overflow: visible;
    box-shadow: 0px 6px 18px rgba(0, 0, 0, 0.18);
  }

  .tab-btn {
    width: 50%;
    height: 65px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  /* 固定插槽，避免选中态被压成圆点 */
  .tab-slot {
    width: 65px;
    height: 55px;
    margin-top: -1px;
    overflow: visible;
  }

  /* 选中：比外框小一圈的嵌套胶囊 */
  .tab-hl {
    width: 65px;
    height: 55px;
    min-width: 65px;
    min-height: 55px;
    position: absolute;
    left: 0px;
    top: 0px;
