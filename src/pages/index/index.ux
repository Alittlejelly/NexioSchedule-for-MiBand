  }

  /* 人员卡：行距作底部留白，避免双倍 */
  .people-card {
    padding-top: 14px;
    padding-bottom: 0px;
  }

  /* 图已预裁圆形透明边，勿再用 border-radius 二次硬裁 */
  .avatar {
    width: 46px;
    height: 46px;
    background-color: transparent;
    margin-right: 12px;
  }

  .person-text {
    flex: 1;
    flex-direction: column;
    align-items: flex-end;
  }

  .person-name {
    width: 100%;
    text-align: left;
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 4px;
    margin-left: 5px;
  }

  .person-role {
    width: 100%;
    text-align: left;
    font-size: 14px;
    font-weight: bold;
    color: #8e8e93;
    margin-left: 5px;
  }

  .line1 {
    width: 100%;
    font-size: 23px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 2px;
    margin-bottom: 9px;
  }

  /* 下节课课名：中间弹性区，长课名折行；min-width 防止被挤成竖排 */
  .strong-next {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 96px;
    lines: -1;
    font-size: 22px;
    font-weight: bold;
    margin-left: 6px;
    margin-right: 6px;
