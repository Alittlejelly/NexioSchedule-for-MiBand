    background-color: #48484a;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  /* 未选中：同尺寸透明占位，避免图标跳动 */
  .tab-hl-off {
    width: 65px;
    height: 55px;
    min-width: 65px;
    min-height: 55px;
    position: absolute;
    left: 0px;
    top: 0px;
    border-radius: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
